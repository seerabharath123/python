def MyDecor_Two(func):
    def MyInner_Two():
        func()
        print("New Functionality for Decorator Two")
    return MyInner_Two

def MyDecor_One(func):
    def MyInner_One():
        func()
        print("New Functionality for Decorator One")
    return MyInner_One

@MyDecor_Two
@MyDecor_One
def MyOrginal():
    print("My Original Function")
